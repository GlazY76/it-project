{
  "name": "codeshelf-backend",
  "version": "1.0.0",
  "description": "CodeShelf online bookstore - REST API (Express 5 + node:sqlite)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.js",
    "db:reset": "node --disable-warning=ExperimentalWarning scripts/reset-db.js",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:coverage": "npm test -- --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
