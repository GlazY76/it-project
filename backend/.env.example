# Copy this file to .env and adjust the values. Relative paths are resolved from the backend/ folder.
NODE_ENV=development
PORT=3000

# Folder that contains shop.db and pictures/
DATA_DIR=../data

# Secret used to sign JWTs - use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

CURRENCY=PLN

# Enables POST /api/orders/:id/pay, a test-mode payment stub (until Stripe test mode is integrated)
MOCK_PAYMENTS=true
